{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "swe hook session-start",
            "statusMessage": "Loading SWE mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swe hook subagent-start",
            "statusMessage": "Loading SWE mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "swe hook prompt-submit",
            "statusMessage": "Tracking SWE mode..."
          }
        ]
      }
    ]
  }
}
